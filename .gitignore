# User data, backups & credentials
config.json
history.json
playlists_backup.json
downloads/
android/app/src/main/python/downloads/

# User uploads (custom avatars & wallpapers)
public/uploads/*
!public/uploads/.gitkeep
android/app/src/main/python/public/uploads/*
!android/app/src/main/python/public/uploads/.gitkeep

