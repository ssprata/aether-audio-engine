__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/

# Node dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android Gradle build outputs & local configuration
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab

# OS & Editor generated files
.DS_Store
Thumbs.db
Desktop.ini
